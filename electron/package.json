{
  "name": "nfc-reader-desktop",
  "version": "1.8.4",
  "private": true,
  "description": "NFC Reader - stessa app Vue su GitHub Pages e Windows portable",
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "bridge:build": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File bridge/build.ps1",
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "pack:win": "electron-builder --win dir --x64 --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "it.nfcreader.desktop",
    "productName": "NFC Reader",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["*.cjs", "package.json", "!**/test/**", "!**/tests/**"],
    "extraResources": [
      {"from": "../", "to": "web", "filter": ["index.html", "manifest.webmanifest", "sw.js", "assets/**"]},
      {"from": "bin/NfcPcscBridge.exe", "to": "pcsc/NfcPcscBridge.exe"}
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "NFC-Reader-Portable-${version}-${arch}.${ext}",
      "icon": "../assets/icons/nfc-reader.ico"
    }
  }
}
